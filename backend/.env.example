PORT=8000
# Frontend base URL for payment redirects; server.js currently uses cors() defaults.
CLIENT_URL=http://localhost:5173
# Local-only mock login switch. Keep false/unset in production.
ALLOW_MOCK_LOGIN=true
# Replace with the connection string from your MongoDB Atlas cluster in backend/.env.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/vna_daksong

# At least 32 random characters. Never put these secrets in frontend VITE_*.
JWT_SECRET=
# Zalo App ID and Secret Key corresponding to your Mini App.
ZALO_APP_ID=
ZALO_APP_SECRET=

# Used only by npm run create:admin. No public admin registration.
ADMIN_NAME=VNA Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail App Password gửi email xác nhận booking
EMAIL_USER=
EMAIL_PASS=
# Base URL of the deployed customer frontend/Mini App for links in booking emails.
EMAIL_APP_URL=
# Optional support contacts shown in the email. Do not use placeholder phone numbers.
EMAIL_SUPPORT_PHONE=
EMAIL_SUPPORT_ADDRESS=

# Optional payment configuration. Keep provider keys in backend only.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=

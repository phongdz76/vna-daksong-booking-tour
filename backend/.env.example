PORT=8000
# Comma-separated frontend/admin origins. The documented Zalo h5 origin is also allowed by the app.
CLIENT_URL=http://localhost:5173
# Local-only mock login switch. Keep false/unset in production.
ALLOW_MOCK_LOGIN=true
# Replace with the connection string from your MongoDB Atlas cluster in backend/.env.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/vna_daksong

# At least 32 random characters. Never put these secrets in frontend VITE_*.
JWT_SECRET=
# Zalo App Secret Key corresponding to your Mini App's app.
ZALO_APP_SECRET=

# Used only by bun run create:admin. No public admin registration.
ADMIN_NAME=VNA Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Test users for local development only. These users are created by npm run seed:test-users.
TEST_USER_BAC_NAME=Nguyen Minh Anh
TEST_USER_BAC_EMAIL=test.bac@vna.local
TEST_USER_BAC_ZALO_ID=mock_test_bac
TEST_USER_BAC_POINTS=0
TEST_USER_VANG_NAME=Tran Quoc Bao
TEST_USER_VANG_EMAIL=test.vang@vna.local
TEST_USER_VANG_ZALO_ID=mock_test_vang
TEST_USER_VANG_POINTS=1000
TEST_USER_KIM_CUONG_NAME=Le Hoang Nam
TEST_USER_KIM_CUONG_EMAIL=test.kimcuong@vna.local
TEST_USER_KIM_CUONG_ZALO_ID=mock_test_kimcuong
TEST_USER_KIM_CUONG_POINTS=5000

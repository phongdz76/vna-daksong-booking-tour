{
  "name": "vna-daksong-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "create:admin": "node createAdmin.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "mongoose": "^9.11.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "watch": [
      "server.js",
      "config",
      "controllers",
      "middlewares",
      "models",
      "routes",
      "utils",
      ".env"
    ],
    "ext": "js,json,env",
    "ignore": [
      "node_modules/**"
    ],
    "exec": "node",
    "env": {
      "VNA_DEV_ENV": "1"
    }
  }
}
